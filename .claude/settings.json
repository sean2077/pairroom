{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "pairroom relay hook --runtime claude",
            "timeout": 45,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "pairroom relay hook --runtime claude",
            "timeout": 45,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR:-.}/.agents/tools/hooks/hook-paths.py\" --guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR:-.}/.agents/tools/hooks/hook-paths.py\" --budget",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
