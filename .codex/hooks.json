{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .agents/tools/hooks/hook-paths.py --guard",
            "statusMessage": "Checking worktree policy",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .agents/tools/hooks/hook-paths.py --budget",
            "statusMessage": "Checking AGENTS.md budget",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
